MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/mydb
JWT_SECRET=<long-random-string-min-32-chars>

# Email (AWS SES) - credentials come from the default AWS chain (EB instance role in prod,
# or the AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY below locally). The role/user needs ses:SendEmail
# on the verified identity and the configuration set.
SES_FROM=KISAR <noreply@yourdomain.com>
SES_REGION=ap-south-1
SES_REPLY_TO=<optional reply-to address>
SES_CONFIG_SET=<optional SES configuration set name>

# App
PORT=3000
NODE_ENV=production/development
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,https://kisar-admin.netlify.app

# S3 image/file storage (banner, gallery, news uploads)
AWS_ACCESS_KEY_ID=<your access key id>
AWS_SECRET_ACCESS_KEY=<your secret access key>
AWS_REGION=ap-south-1
S3_BUCKET_NAME=kisar-portal-uploads-prod

# Event payments (Cashfree). Use the sandbox keys until KYC is complete.
CASHFREE_APP_ID=<cashfree app id>
CASHFREE_SECRET_KEY=<cashfree secret key>
CASHFREE_ENV=sandbox
# Optional (defaults to 2023-08-01)
CASHFREE_API_VERSION=2023-08-01
# Public HTTPS URL of POST /api/v1/payments/cashfree/webhook (needs a tunnel such as ngrok locally)
CASHFREE_WEBHOOK_URL=https://<your-api-host>/api/v1/payments/cashfree/webhook
# Frontend page Cashfree returns the user to; receives ?order_id=...
PAYMENT_RETURN_URL=https://www.kisar.org.in/events/registration/return
